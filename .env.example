# Local defaults. Production values for Railway project divine-nourishment
# (environment: production, service: pubcommand) are in DEPLOY.md.
# Do not put real secrets in this file.

# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pubcommand

# Railway: REDIS_URL=${{Redis.REDIS_URL}}
# Read by the worker. The web process reports whether it is set. No queue is attached in Phase 1.
REDIS_URL=

# Bucket pubcommand-files. Set each app variable from the bucket variable in parentheses.
# S3_ENDPOINT=${{pubcommand-files.ENDPOINT}}
# S3_BUCKET=${{pubcommand-files.BUCKET}}
# S3_ACCESS_KEY_ID=${{pubcommand-files.ACCESS_KEY_ID}}
# S3_SECRET_ACCESS_KEY=${{pubcommand-files.SECRET_ACCESS_KEY}}
# S3_REGION=${{pubcommand-files.REGION}}
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Generate a long random string. Required. Never commit a real value.
AUTH_SECRET=replace-with-a-long-random-string

# Local development uses localhost so ?org= and ?site= work.
# Railway production must be pubcommand.com.
ROOT_DOMAIN=localhost

# Used by scripts/start-web.sh and pnpm db:seed. Matched case-insensitively.
SUPERADMIN_EMAIL=Stephen@onenationfinancial.com

# Optional bcrypt hash ($2a$ or $2b$). When set, every boot writes it to that user's password_hash.
# SUPERADMIN_PASSWORD_HASH=

# Optional public origin. Magic links use the request host when this is unset.
# APP_URL=http://localhost:3000

# Local only. Ignored when NODE_ENV=production. Shows the magic link on the login page.
AUTH_DEV_EXPOSE_LINKS=true

# Staff two-factor (authenticator app) is off unless this is "true".
# REQUIRE_STAFF_2FA=true

# When set, magic links and invites are emailed through Resend. Otherwise the URL is logged as [magic-link].
# RESEND_API_KEY=
EMAIL_FROM=login@pubcommand.com

# Not required in Phase 1. The Anthropic provider does not call the network.
# ANTHROPIC_API_KEY=
