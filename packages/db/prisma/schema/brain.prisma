// Brain (knowledge) tables.
enum KnowledgeVisibility {
  PRIVATE
  SHARED
}

enum KnowledgeRunStatus {
  DRY_RUN
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// A brand's mini-brain notes. SHARED notes are visible to the organization's other brands.
/// Rows with brandId null are legacy organization-level notes, moved to main_brain_notes.
model KnowledgePage {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  brandId        String?                  @map("brand_id") @db.Uuid
  title          String
  slug           String
  body           String
  visibility     KnowledgeVisibility      @default(PRIVATE)
  folder         String?
  source         String                   @default("member")
  sourceRef      String?                  @map("source_ref")
  createdById    String?                  @map("created_by_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  /// Soft delete. Deleted notes never show in a Brain or in search.
  deletedAt      DateTime?                @map("deleted_at")
  updatedById    String?                  @map("updated_by_id") @db.Uuid
  sharedAt       DateTime?                @map("shared_at")
  sharedById     String?                  @map("shared_by_id") @db.Uuid
  /// Set on an old organization-level note (brandId null) once it was copied into
  /// the platform main Brain (main_brain_notes). Such rows are never shown in an org.
  movedToMainAt  DateTime?                @map("moved_to_main_at")
  /// Generated by Postgres from title (weight A) and body (weight B). Read-only.
  searchVector   Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, \"left\"(COALESCE(body, ''::text), 500000)), 'B'::\"char\"))")) @map("search_vector")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand          Brand?                   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  attachments    KnowledgeAttachment[]

  @@unique([organizationId, slug])
  @@unique([organizationId, sourceRef])
  @@index([organizationId, brandId])
  @@index([organizationId, visibility])
  @@index([searchVector], type: Gin)
  @@map("knowledge_pages")
}

/// One "Ask the Brain" question in a brand mini-brain, saved in the asker's history.
model KnowledgeQuestion {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  brandId        String?            @map("brand_id") @db.Uuid
  question       String
  status         KnowledgeRunStatus @default(QUEUED)
  /// { answer, citations: [{ noteId, title, why }], consideredIds }
  answer         Json?
  error          String?
  model          String?
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  /// Starred in the asker's history.
  savedAt        DateTime?          @map("saved_at")
  /// Removed from the asker's history (kept for the audit trail).
  hiddenAt       DateTime?          @map("hidden_at")

  @@index([organizationId, brandId, createdAt])
  @@index([organizationId, createdById, createdAt])
  @@map("knowledge_questions")
}

/// A Markdown vault upload. The zip is kept until the import finishes, then cleared.
model KnowledgeImport {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  /// Target Brain: a brand's mini-brain, or null for the main Brain.
  brandId        String?            @map("brand_id") @db.Uuid
  filename       String
  size           Int
  data           Bytes
  status         KnowledgeRunStatus @default(DRY_RUN)
  /// Dry-run plan, then the final result.
  report         Json?
  error          String?
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([organizationId, createdAt])
  @@map("knowledge_imports")
}

/// An image or file attached to a mini-brain note. Bytes live in Postgres.
model KnowledgeAttachment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  noteId         String        @map("note_id") @db.Uuid
  filename       String
  contentType    String        @map("content_type")
  size           Int
  data           Bytes
  createdById    String?       @map("created_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  note           KnowledgePage @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, filename])
  @@index([organizationId])
  @@map("knowledge_attachments")
}

// ---------------------------------------------------------------------------
// The main Brain: platform level, PubCommand staff only (admin console).
//
// These tables have NO organization_id column on purpose: the tenant client
// (packages/db/src/tenant.ts) only exposes models with an `organizationId`
// field, so org code cannot reach them. Row-level security allows access only
// inside a transaction that sets app.bypass_rls (features/main-brain/db.ts).
// Provenance columns are prefixed `origin` for the same reason.

enum MainBrainOrigin {
  /// Taught to a brand mini-brain by an app (teachBrain) and learned up.
  LEARNED
  /// Imported from a Markdown vault in the console.
  IMPORTED
  /// Written by staff in the console.
  AUTHORED
  /// An old organization-level note (knowledge_pages.brand_id IS NULL) moved here.
  MIGRATED
}

enum MainBrainPushScope {
  NONE
  ALL
  SELECTED
}

model MainBrainNote {
  id                   String                   @id @default(uuid()) @db.Uuid
  /// Idempotency key: learned:<orgId>:<sourceRef> | vault:<path> | migrated:<id> | note:<uuid>
  key                  String                   @unique
  title                String
  slug                 String                   @unique
  body                 String
  folder               String?
  origin               MainBrainOrigin
  /// "finance" | "health" | "general". Finance and health notes only ever reach brands of
  /// the same niche; general notes reach every niche. From the source brand, the import, or staff.
  niche                String                   @default("general")
  /// The app that taught it ("promo-analyzer"), "vault-import" or "staff".
  source               String
  originOrganizationId String?                  @map("origin_organization_id") @db.Uuid
  originBrandId        String?                  @map("origin_brand_id") @db.Uuid
  originSourceRef      String?                  @map("origin_source_ref")
  /// The knowledge_pages row it was learned or migrated from.
  originNoteId         String?                  @map("origin_note_id") @db.Uuid
  /// Extra provenance (e.g. a migrated note's original visibility).
  originMeta           Json?                    @map("origin_meta")
  learnedAt            DateTime?                @map("learned_at")
  /// Set when staff edit the note: later learning updates no longer overwrite it.
  editedAt             DateTime?                @map("edited_at")
  pushScope            MainBrainPushScope       @default(NONE) @map("push_scope")
  pushedAt             DateTime?                @map("pushed_at")
  pushedById           String?                  @map("pushed_by_id") @db.Uuid
  createdById          String?                  @map("created_by_id") @db.Uuid
  updatedById          String?                  @map("updated_by_id") @db.Uuid
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  deletedAt            DateTime?                @map("deleted_at")
  searchVector         Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, \"left\"(COALESCE(body, ''::text), 500000)), 'B'::\"char\"))")) @map("search_vector")
  pushTargets          MainBrainPushTarget[]
  attachments          MainBrainAttachment[]

  @@index([originOrganizationId, originBrandId])
  @@index([origin])
  @@index([niche])
  @@index([pushScope])
  @@index([searchVector], type: Gin)
  @@map("main_brain_notes")
}

/// Brands a main-Brain note is pushed down to (pushScope SELECTED).
model MainBrainPushTarget {
  noteId               String        @map("note_id") @db.Uuid
  brandId              String        @map("brand_id") @db.Uuid
  targetOrganizationId String        @map("target_organization_id") @db.Uuid
  createdById          String?       @map("created_by_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  note                 MainBrainNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([noteId, brandId])
  @@index([brandId])
  @@map("main_brain_push_targets")
}

model MainBrainAttachment {
  id          String        @id @default(uuid()) @db.Uuid
  noteId      String        @map("note_id") @db.Uuid
  filename    String
  contentType String        @map("content_type")
  size        Int
  data        Bytes
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  note        MainBrainNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, filename])
  @@map("main_brain_attachments")
}

/// "Ask the main Brain", saved per staff member.
model MainBrainQuestion {
  id        String             @id @default(uuid()) @db.Uuid
  question  String
  status    KnowledgeRunStatus @default(QUEUED)
  answer    Json?
  error     String?
  model     String?
  askedById String?            @map("asked_by_id") @db.Uuid
  savedAt   DateTime?          @map("saved_at")
  hiddenAt  DateTime?          @map("hidden_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([askedById, createdAt])
  @@map("main_brain_questions")
}

/// A vault zip imported into the main Brain from the console.
model MainBrainImport {
  id          String             @id @default(uuid()) @db.Uuid
  filename    String
  size        Int
  data        Bytes
  /// Niche for notes in this vault without a `niche:` line in their frontmatter.
  niche       String             @default("general")
  status      KnowledgeRunStatus @default(DRY_RUN)
  report      Json?
  error       String?
  createdById String?            @map("created_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("main_brain_imports")
}
