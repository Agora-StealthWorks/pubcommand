// Brain (knowledge) tables.
enum KnowledgeVisibility {
  PRIVATE
  SHARED
}

enum KnowledgeRunStatus {
  DRY_RUN
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Brain notes. brandId null = the main Brain. SHARED notes are visible to every brand.
model KnowledgePage {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  brandId        String?                  @map("brand_id") @db.Uuid
  title          String
  slug           String
  body           String
  visibility     KnowledgeVisibility      @default(PRIVATE)
  folder         String?
  source         String                   @default("member")
  sourceRef      String?                  @map("source_ref")
  createdById    String?                  @map("created_by_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  /// Soft delete. Deleted notes never show in a Brain or in search.
  deletedAt      DateTime?                @map("deleted_at")
  updatedById    String?                  @map("updated_by_id") @db.Uuid
  sharedAt       DateTime?                @map("shared_at")
  sharedById     String?                  @map("shared_by_id") @db.Uuid
  /// Generated by Postgres from title (weight A) and body (weight B). Read-only.
  searchVector   Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, \"left\"(COALESCE(body, ''::text), 500000)), 'B'::\"char\"))")) @map("search_vector")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand          Brand?                   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@unique([organizationId, sourceRef])
  @@index([organizationId, brandId])
  @@index([organizationId, visibility])
  @@index([searchVector], type: Gin)
  @@map("knowledge_pages")
}

/// One "Ask the Brain" question. brandId null = asked of the main Brain.
model KnowledgeQuestion {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  brandId        String?            @map("brand_id") @db.Uuid
  question       String
  status         KnowledgeRunStatus @default(QUEUED)
  /// { answer, citations: [{ noteId, title, why }], consideredIds }
  answer         Json?
  error          String?
  model          String?
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([organizationId, brandId, createdAt])
  @@map("knowledge_questions")
}

/// A Markdown vault upload. The zip is kept until the import finishes, then cleared.
model KnowledgeImport {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  /// Target Brain: a brand's mini-brain, or null for the main Brain.
  brandId        String?            @map("brand_id") @db.Uuid
  filename       String
  size           Int
  data           Bytes
  status         KnowledgeRunStatus @default(DRY_RUN)
  /// Dry-run plan, then the final result.
  report         Json?
  error          String?
  createdById    String?            @map("created_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([organizationId, createdAt])
  @@map("knowledge_imports")
}
