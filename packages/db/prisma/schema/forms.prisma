// Forms tables. Respondent answers are PII: they stay in these tables and
// leave only through an admin export (forms.export). The Brain gets aggregates.
//
// No relation fields to Organization/Brand/User (shared files). Foreign keys
// to those tables are added by hand in the migration SQL.

enum FormStatus {
  DRAFT
  OPEN
  CLOSED
}

enum FormResponseStatus {
  PARTIAL
  COMPLETE
}

enum FormSummaryStatus {
  RUNNING
  DONE
  FAILED
}

/// The public look of a form: logo, colours and the privacy-policy link every public form shows.
model FormTheme {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  brandId          String    @map("brand_id") @db.Uuid
  name             String
  logoFileId       String?   @map("logo_file_id") @db.Uuid
  logoUrl          String?   @map("logo_url")
  logoLinkUrl      String?   @map("logo_link_url")
  logoHeight       Int?      @map("logo_height")
  headerSize       String    @default("standard") @map("header_size")
  barColor         String    @default("#0b1220") @map("bar_color")
  accentColor      String    @default("#1d4ed8") @map("accent_color")
  privacyPolicyUrl String    @map("privacy_policy_url")
  companyName      String    @default("") @map("company_name")
  footerText       String?   @map("footer_text")
  isDefault        Boolean   @default(false) @map("is_default")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  forms            Form[]
  folders          FormFolder[]

  @@index([organizationId, brandId])
  @@map("form_themes")
}

/// A flat group of forms. Deleting one moves its forms to Unfiled.
model FormFolder {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  brandId        String     @map("brand_id") @db.Uuid
  name           String
  defaultThemeId String?    @map("default_theme_id") @db.Uuid
  position       Int        @default(0)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  defaultTheme   FormTheme? @relation(fields: [defaultThemeId], references: [id], onDelete: SetNull)
  forms          Form[]

  @@index([organizationId, brandId])
  @@map("form_folders")
}

model Form {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  brandId            String       @map("brand_id") @db.Uuid
  folderId           String?      @map("folder_id") @db.Uuid
  themeId            String?      @map("theme_id") @db.Uuid
  title              String
  internalName       String?      @map("internal_name")
  /// Public link: https://{org}.pubcommand.com/f/<slug>. Unique per organization.
  slug               String
  description        String       @default("")
  status             FormStatus   @default(DRAFT)
  opensAt            DateTime?    @map("opens_at")
  closesAt           DateTime?    @map("closes_at")
  responseLimit      Int?         @map("response_limit")
  layout             String       @default("paginated")
  showProgress       Boolean      @default(true) @map("show_progress")
  autoAdvance        Boolean      @default(true) @map("auto_advance")
  submitLabel        String       @default("Submit") @map("submit_label")
  confirmTitle       String       @default("Thank you!") @map("confirm_title")
  confirmMessage     String       @default("Your response has been recorded.") @map("confirm_message")
  redirectUrl        String?      @map("redirect_url")
  closedMessage      String       @default("This form is not taking responses right now.") @map("closed_message")
  /// Rewords the disclaimer. The privacy-policy link is appended regardless.
  disclaimerOverride String?      @map("disclaimer_override")
  brainSyncEnabled   Boolean      @default(true) @map("brain_sync_enabled")
  /// End-of-form rules (modules/forms/logic.ts EndRule[]): first match picks a redirect or a thank-you variant.
  endRules           Json         @default("[]") @map("end_rules")
  /// Publish on its own at opensAt (forms.schedule job), if the publish checks pass.
  autoPublish        Boolean      @default(false) @map("auto_publish")
  /// Why the scheduled publish did not happen, shown on the form.
  scheduleNote       String?      @map("schedule_note")
  /// Team members (user ids) emailed about new responses.
  notifyUserIds      String[]     @default([]) @map("notify_user_ids")
  /// off | each | digest
  notifyMode         String       @default("off") @map("notify_mode")
  /// Include the answers in the email (only recipients with forms.export get them).
  notifyIncludeAnswers Boolean    @default(false) @map("notify_include_answers")
  notifyDigestSentAt DateTime?    @map("notify_digest_sent_at")
  /// Email the respondent a confirmation at the address they gave in confirmEmailFieldId.
  confirmEmailEnabled Boolean     @default(false) @map("confirm_email_enabled")
  confirmEmailFieldId String?     @map("confirm_email_field_id") @db.Uuid
  confirmEmailSubject String      @default("") @map("confirm_email_subject")
  confirmEmailBody    String      @default("") @map("confirm_email_body")
  /// Public live results page (/f/<slug>/results): aggregates of closed questions only.
  publicResultsEnabled Boolean    @default(false) @map("public_results_enabled")
  publicResultsMin     Int        @default(5) @map("public_results_min")
  publishedAt        DateTime?    @map("published_at")
  createdById        String?      @map("created_by_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")
  folder             FormFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  theme              FormTheme?   @relation(fields: [themeId], references: [id], onDelete: SetNull)
  fields             FormField[]
  responses          FormResponse[]
  files              FormFile[]
  summaries          FormSummary[]
  mirror             FormMirror?

  @@unique([organizationId, slug])
  @@index([organizationId, brandId, updatedAt])
  @@map("forms")
}

/// One question or layout block. Type and config shapes are defined in modules/forms/fields.ts.
model FormField {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  formId         String   @map("form_id") @db.Uuid
  position       Int
  type           String
  label          String   @default("")
  helpText       String   @default("") @map("help_text")
  placeholder    String   @default("")
  required       Boolean  @default(false)
  config         Json     @default("{}")
  /// Show/hide rule from earlier answers (modules/forms/logic.ts). Null = always shown.
  visibility     Json?
  /// Forward jumps after this field's page (modules/forms/logic.ts).
  skipLogic      Json?    @map("skip_logic")
  groupWithNext  Boolean  @default(false) @map("group_with_next")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  form           Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([organizationId, formId, position])
  @@map("form_fields")
}

/// A response, partial (autosaved) or complete. answers is { fieldId: value }. PII.
model FormResponse {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  formId         String             @map("form_id") @db.Uuid
  status         FormResponseStatus @default(PARTIAL)
  /// Secret the browser holds to keep updating its OWN partial response.
  resumeToken    String             @unique @map("resume_token")
  answers        Json               @default("{}")
  startedAt      DateTime           @default(now()) @map("started_at")
  completedAt    DateTime?          @map("completed_at")
  lastPageIndex  Int                @default(0) @map("last_page_index")
  durationMs     Int?               @map("duration_ms")
  /// Salted SHA-256 of the IP. The raw IP is never stored.
  ipHash         String?            @map("ip_hash")
  userAgent      String?            @map("user_agent")
  referrer       String?
  utm            Json?
  /// Why this was flagged as suspected spam. Flagged responses are kept and held out of figures.
  spamReason     String?            @map("spam_reason")
  /// When the team was emailed about it (each or digest). Null = not yet.
  notifiedAt     DateTime?          @map("notified_at")
  confirmationSentAt DateTime?      @map("confirmation_sent_at")
  /// One-way mirror state: null (no mirror) | pending | ok | failed
  mirrorStatus   String?            @map("mirror_status")
  mirrorAttempts Int                @default(0) @map("mirror_attempts")
  mirrorError    String?            @map("mirror_error")
  mirrorTriedAt  DateTime?          @map("mirror_tried_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  form           Form               @relation(fields: [formId], references: [id], onDelete: Cascade)
  files          FormFile[]

  @@index([organizationId, formId, status, completedAt])
  @@index([organizationId, formId, startedAt])
  @@index([organizationId, mirrorStatus])
  @@index([organizationId, notifiedAt])
  @@map("form_responses")
}

/// Uploaded files, signature images and theme logos, in Postgres (no volume).
model FormFile {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  formId         String?       @map("form_id") @db.Uuid
  responseId     String?       @map("response_id") @db.Uuid
  fieldId        String?       @map("field_id") @db.Uuid
  /// upload | signature | logo
  kind           String
  filename       String
  mimeType       String        @map("mime_type")
  size           Int
  data           Bytes
  createdAt      DateTime      @default(now()) @map("created_at")
  form           Form?         @relation(fields: [formId], references: [id], onDelete: Cascade)
  response       FormResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([organizationId, formId])
  @@index([organizationId, responseId])
  @@map("form_files")
}

/// A stored AI summary of a form's results (aggregates only).
model FormSummary {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  formId         String            @map("form_id") @db.Uuid
  status         FormSummaryStatus @default(RUNNING)
  error          String?
  model          String?
  result         Json?
  responseCount  Int               @default(0) @map("response_count")
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  form           Form              @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([organizationId, formId, createdAt])
  @@map("form_summaries")
}

/// One-way copy of each new response into the author's own Airtable table or
/// Google Sheet. Credentials are AES-GCM encrypted with AUTH_SECRET. Nothing
/// is ever read back from the destination.
model FormMirror {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  formId         String    @unique @map("form_id") @db.Uuid
  /// airtable | google_sheets
  provider       String
  enabled        Boolean   @default(true)
  /// Non-secret target: { baseId, table } or { spreadsheetId, sheet }.
  target         Json      @default("{}")
  secretCipher   String    @map("secret_cipher")
  lastError      String?   @map("last_error")
  lastSyncedAt   DateTime? @map("last_synced_at")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  form           Form      @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("form_mirrors")
}
