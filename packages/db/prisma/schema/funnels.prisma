// Funnels tables: launch funnels (waitlist → day videos → close page). The
// text_* tables moved to miniblog.prisma (Mini-Blog app).
//
// Opt-in emails are PII: they stay in these tables and leave only through an
// admin CSV export (funnels.publish). The Brain gets aggregates.
//
// No relation fields to Organization/Brand/User (shared files). Foreign keys to
// those tables are added by hand in the migration SQL.

/// One launch funnel. Times are stored UTC; the builder shows the org time zone.
model Funnel {
  id                     String          @id @default(uuid()) @db.Uuid
  organizationId         String          @map("organization_id") @db.Uuid
  brandId                String          @map("brand_id") @db.Uuid
  name                   String
  /// Public link: https://{org}.pubcommand.com/l/<slug>. Unique per organization.
  slug                   String
  /// draft | published | archived
  status                 String          @default("draft")
  /// evergreen | live
  mode                   String          @default("evergreen")
  /// fixed | per_viewer
  timing                 String          @default("fixed")
  startAt                DateTime?       @map("start_at")
  endAt                  DateTime?       @map("end_at")
  closeAfterHours        Int?            @map("close_after_hours")
  livestreamUrl          String?         @map("livestream_url")
  /// all_open | scheduled | watch_percent | url_key
  progression            String          @default("all_open")
  watchPercent           Int             @default(80) @map("watch_percent")
  /// as_you_go | prebuilt
  buildMode              String          @default("as_you_go") @map("build_mode")
  /// page | redirect | never
  closeMode              String          @default("page") @map("close_mode")
  closeHeadline          String          @default("This event has closed") @map("close_headline")
  closeMessageHtml       String          @default("<p>Thanks for your interest. This event is no longer available.</p>") @map("close_message_html")
  closeButtonText        String?         @map("close_button_text")
  closeButtonUrl         String?         @map("close_button_url")
  closeRedirectUrl       String?         @map("close_redirect_url")
  waitlistEnabled        Boolean         @default(true) @map("waitlist_enabled")
  waitlistHeadline       String          @default("It starts in…") @map("waitlist_headline")
  waitlistSubheadline    String          @default("Keep this page open. You will be taken in automatically the moment it begins.") @map("waitlist_subheadline")
  agendaTitle            String          @default("Agenda") @map("agenda_title")
  /// none | email | form
  optinMode              String          @default("none") @map("optin_mode")
  optinFormSlug          String?         @map("optin_form_slug")
  optinHeadline          String          @default("Get a reminder before we start") @map("optin_headline")
  optinButtonText        String          @default("Remind me") @map("optin_button_text")
  /// Forms theme to borrow logo, colours and privacy link from. Null = the funnel's own branding.
  formThemeId            String?         @map("form_theme_id") @db.Uuid
  logoAssetId            String?         @map("logo_asset_id") @db.Uuid
  logoUrl                String?         @map("logo_url")
  logoHeight             Int             @default(40) @map("logo_height")
  headerBg               String          @default("#111827") @map("header_bg")
  pageBg                 String          @default("#f5f6f8") @map("page_bg")
  textColor              String          @default("#1f2937") @map("text_color")
  accentColor            String          @default("#1d4ed8") @map("accent_color")
  companyName            String          @default("") @map("company_name")
  privacyUrl             String?         @map("privacy_url")
  termsUrl               String?         @map("terms_url")
  /// Sanitized rich text.
  footerHtml             String          @default("") @map("footer_html")
  lockedTitle            String          @default("This video is locked") @map("locked_title")
  lockedScheduledMsg     String          @default("{day} unlocks on {unlock_date}. Check back then!") @map("locked_scheduled_msg")
  lockedWatchMsg         String          @default("Watch at least {percent}% of {prev_day} to unlock {day}.") @map("locked_watch_msg")
  lockedKeyMsg           String          @default("{day} unlocks from the link in your email.") @map("locked_key_msg")
  lockedLiveMsg          String          @default("{day} goes live on {unlock_date}.") @map("locked_live_msg")
  lockedPassedMsg        String          @default("{day} is no longer available. {next_day} is open now.") @map("locked_passed_msg")
  /// Docuseries: hours each module stays open after it opens for the viewer, then "expired". Null = never.
  accessHours            Int?            @map("access_hours")
  lockedExpiredMsg       String          @default("{day} is no longer available. Get full access to watch every episode any time.") @map("locked_expired_msg")
  /// boxes | flip: the look of every countdown (waitlist, video box, deadline bar, blocks).
  countdownStyle         String          @default("boxes") @map("countdown_style")
  /// When a countdown runs out: reload (into the newly open page) | stay (show 00:00:00).
  countdownZero          String          @default("reload") @map("countdown_zero")
  /// Locked module box: background / text colours (null = design colours) and minimal (headline + countdown only).
  lockedBoxBg            String?         @map("locked_box_bg")
  lockedBoxText          String?         @map("locked_box_text")
  lockedBoxMinimal       Boolean         @default(false) @map("locked_box_minimal")
  /// Module navigation: strip (thumbnail tiles above the video) | strip_status (the strip with titles and status lines) | sidebar (episode list beside the video).
  navLayout              String          @default("strip") @map("nav_layout")
  /// Blur the thumbnails of locked / expired modules in the navigation.
  navBlurLocked          Boolean         @default(false) @map("nav_blur_locked")
  /// Offer section under module pages (anchor #offer), validated by modules/funnels/blocks.ts.
  offerBlocks            Json            @default("[]") @map("offer_blocks")
  offerBlocksDraft       Json?           @map("offer_blocks_draft")
  comingSoonTitle        String          @default("Coming soon") @map("coming_soon_title")
  comingSoonMessage      String          @default("This video will be available shortly. Check back soon!") @map("coming_soon_message")
  replayPendingTitle     String          @default("The replay is on its way") @map("replay_pending_title")
  replayPendingMessage   String          @default("The live session has ended. The replay will be posted here shortly.") @map("replay_pending_message")
  liveHeadline           String          @default("We're live!") @map("live_headline")
  liveSubheadline        String          @default("Taking you to the livestream room…") @map("live_subheadline")
  nextButtonText         String          @default("Watch the next day") @map("next_button_text")
  brainSyncEnabled       Boolean         @default(true) @map("brain_sync_enabled")
  /// launch (waitlist front door) | microsite (a block-built home page is the front door)
  siteType               String          @default("launch") @map("site_type")
  /// Microsite: show the site header + module navigation above the home page blocks.
  homeShell              Boolean         @default(true) @map("home_shell")
  /// Browser title of the home page. Empty = the funnel name.
  homeTitle              String          @default("") @map("home_title")
  /// Ordered home page blocks, validated by modules/funnels/blocks.ts.
  homeBlocks             Json            @default("[]") @map("home_blocks")
  /// Unsaved builder draft, shown only in the builder's live preview.
  homeBlocksDraft        Json?           @map("home_blocks_draft")
  /// Design tokens (header, page, content box, nav tiles, footer), validated by modules/funnels/design.ts.
  design                 Json            @default("{}")
  /// Unsaved design draft, shown only in the builder's live preview.
  designDraft            Json?           @map("design_draft")
  /// Waitlist: show the hosts below the agenda.
  hostsEnabled           Boolean         @default(false) @map("hosts_enabled")
  hostsTitle             String          @default("Meet your hosts") @map("hosts_title")
  deadlineBarEnabled     Boolean         @default(false) @map("deadline_bar_enabled")
  /// end (funnel close; per viewer on evergreen) | start | custom
  deadlineBarTarget      String          @default("end") @map("deadline_bar_target")
  deadlineBarAt          DateTime?       @map("deadline_bar_at")
  /// top | bottom
  deadlineBarPosition    String          @default("bottom") @map("deadline_bar_position")
  deadlineBarSticky      Boolean         @default(true) @map("deadline_bar_sticky")
  /// Tokens: {date} {short_date}
  deadlineBarText        String          @default("This offer ends in") @map("deadline_bar_text")
  deadlineBarBg          String          @default("#b42318") @map("deadline_bar_bg")
  deadlineBarColor       String          @default("#ffffff") @map("deadline_bar_color")
  /// Only show in the last N hours before the deadline (0 = always).
  deadlineBarWithinHours Int             @default(0) @map("deadline_bar_within_hours")
  /// Page kinds the bar shows on: home | waitlist | day | custom.
  deadlineBarPages       String[]        @default(["home", "waitlist", "day", "custom"]) @map("deadline_bar_pages")
  /// Optional button on the bar. Empty text = no button. URL or "module:<n>".
  deadlineBarButtonText  String          @default("") @map("deadline_bar_button_text")
  deadlineBarButtonUrl   String          @default("") @map("deadline_bar_button_url")
  /// Visitors may hide the bar (remembered for the browser session).
  deadlineBarDismiss     Boolean         @default(false) @map("deadline_bar_dismiss")
  /// Waitlist opt-in when optin_mode = "sms": a funnel_sms_forms id.
  optinSmsFormId         String?         @map("optin_sms_form_id") @db.Uuid
  /// Browser-tab icon: an uploaded asset (kind favicon) or an https URL.
  faviconAssetId         String?         @map("favicon_asset_id") @db.Uuid
  faviconUrl             String?         @map("favicon_url")
  /// Raw admin HTML (tracking pixels, tag managers). Public pages only, never previews.
  /// <meta>/<link> tags go to <head>; the rest to the top of <body>. funnels.publish only.
  headCode               String          @default("") @map("head_code")
  /// Raw admin HTML at the end of <body>. funnels.publish only.
  footerCode             String          @default("") @map("footer_code")
  /// Sender name on invites and reminders. Empty = the company name.
  emailFromName          String          @default("") @map("email_from_name")
  emailReplyTo           String?         @map("email_reply_to")
  /// The first module follows scheduled / link-key progression too.
  lockFirstModule        Boolean         @default(false) @map("lock_first_module")
  /// Scheduled / watch % progression: each module's ?k= link (from an email) also unlocks it early.
  keyForceUnlock         Boolean         @default(false) @map("key_force_unlock")
  /// A module locks again once the viewer has a later module open (B, C and D; never live modules).
  lockPassedModules      Boolean         @default(false) @map("lock_passed_modules")
  /// With lockPassedModules: passed modules drop out of the navigation strip instead of showing locked.
  hidePassedModules      Boolean         @default(false) @map("hide_passed_modules")
  /// Live: where the front door goes between sessions: hybrid | recent | next
  betweenSessions        String          @default("hybrid") @map("between_sessions")
  /// Live: countdown in the video box on the calendar day of a session.
  liveCountdown          Boolean         @default(true) @map("live_countdown")
  liveCountdownTitle     String          @default("We go live in…") @map("live_countdown_title")
  /// Live: on a later session's page, point to today's earlier session while it is still to come or live.
  todayTrainingEnabled   Boolean         @default(true) @map("today_training_enabled")
  todayTrainingText      String          @default("Join today's session") @map("today_training_text")
  /// Tokens: {day} {time}
  todayTrainingMsg       String          @default("Today's live session, {day}, starts at {time}.") @map("today_training_msg")
  /// Tokens: {day}
  todayTrainingLiveMsg   String          @default("Today's live session, {day}, is live right now!") @map("today_training_live_msg")
  /// Countdown in a locked (timed) module's box: day_of | always | off
  unlockCountdownMode    String          @default("day_of") @map("unlock_countdown_mode")
  unlockCountdownTitle   String          @default("Unlocks in…") @map("unlock_countdown_title")
  /// Live: N minutes before a session, swap Add to calendar for a "join early" button.
  earlyJoinEnabled       Boolean         @default(false) @map("early_join_enabled")
  earlyJoinMinutes       Int             @default(15) @map("early_join_minutes")
  earlyJoinText          String          @default("Join the room early") @map("early_join_text")
  /// Empty = the session's livestream room.
  earlyJoinUrl           String?         @map("early_join_url")
  prevButtonText         String          @default("Watch the previous day") @map("prev_button_text")
  /// Live: Add to calendar on upcoming sessions and the waitlist.
  calendarEnabled        Boolean         @default(true) @map("calendar_enabled")
  calendarButtonText     String          @default("Add to calendar") @map("calendar_button_text")
  /// builtin (Google / Apple / Outlook from the session time) | url (a calendar tool link)
  calendarMode           String          @default("builtin") @map("calendar_mode")
  calendarUrl            String?         @map("calendar_url")
  /// Tokens: {funnel} {day} {title}
  calInviteTitle         String          @default("{funnel}: {title}") @map("cal_invite_title")
  /// Tokens: {agenda} {topics} {room_url} {page_url} {day} {title} {date} {time}
  calInviteDesc          String          @default("You're registered! Join the livestream here:\n{room_url}\n\n{title} goes live {date}.") @map("cal_invite_desc")
  /// Minutes before the start, comma-separated (.ics only).
  calReminders           String          @default("1440,60,15") @map("cal_reminders")
  /// individual | series
  calInviteScope         String          @default("individual") @map("cal_invite_scope")
  /// Waitlist colours. Empty = the header colours (older funnels keep their look).
  waitlistBg             String          @default("") @map("waitlist_bg")
  waitlistText           String          @default("") @map("waitlist_text")
  waitlistBgImageUrl     String?         @map("waitlist_bg_image_url")
  countdownBoxBg         String          @default("#ffffff") @map("countdown_box_bg")
  countdownDigit         String          @default("#111827") @map("countdown_digit")
  homeworkEnabled        Boolean         @default(false) @map("homework_enabled")
  homeworkTitle          String          @default("Pre-event homework") @map("homework_title")
  homeworkSubtitle       String          @default("") @map("homework_subtitle")
  /// [{ label, url, style: button|link, newTab }]
  homeworkItems          Json            @default("[]") @map("homework_items")
  /// Empty = the page colours.
  hostsBg                String          @default("") @map("hosts_bg")
  hostsTitleColor        String          @default("") @map("hosts_title_color")
  /// list | cards
  agendaLayout           String          @default("list") @map("agenda_layout")
  agendaBg               String          @default("") @map("agenda_bg")
  agendaText             String          @default("") @map("agenda_text")
  /// Heading over the calendar-buttons embed under each video. Empty = none.
  livendarTitle          String          @default("Add this event to your calendar") @map("livendar_title")
  /// Default calendar-buttons embed (sanitized, no scripts) under every module's video.
  livendarHtml           String          @default("") @map("livendar_html")
  deadlineBarDigitColor  String?         @map("deadline_bar_digit_color")
  deadlineBarButtonBg    String?         @map("deadline_bar_button_bg")
  /// narrow | wide
  deadlineBarSpacing     String          @default("narrow") @map("deadline_bar_spacing")
  publishedAt            DateTime?       @map("published_at")
  createdById            String?         @map("created_by_id") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  deletedAt              DateTime?       @map("deleted_at")
  days                   FunnelDay[]
  events                 FunnelEvent[]
  watches                FunnelWatch[]
  optins                 FunnelOptin[]
  hosts                  FunnelHost[]
  navItems               FunnelNavItem[]
  emails                 FunnelEmail[]
  emailSends             FunnelEmailSend[]
  smsForms               FunnelSmsForm[]
  smsOptins              FunnelSmsOptin[]
  delegates              FunnelDelegate[]

  @@unique([organizationId, slug])
  @@index([organizationId, brandId, updatedAt])
  @@map("funnels")
}

model FunnelDay {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  funnelId          String    @map("funnel_id") @db.Uuid
  /// 1-based order.
  position          Int
  title             String    @default("")
  /// A short description of the module (episode grid cards).
  summary           String    @default("")
  navLabel          String?   @map("nav_label")
  /// Agenda bullets.
  topics            String[]  @default([])
  /// Sanitized rich text under the video.
  bodyHtml          String    @default("") @map("body_html")
  /// wistia | youtube
  videoProvider     String?   @map("video_provider")
  videoId           String?   @map("video_id")
  videoTitle        String?   @map("video_title")
  /// From oEmbed (automatic).
  videoThumbUrl     String?   @map("video_thumb_url")
  videoDuration     Int?      @map("video_duration")
  /// Manual thumbnail overrides; either one wins over the automatic one.
  thumbAssetId      String?   @map("thumb_asset_id") @db.Uuid
  thumbUrl          String?   @map("thumb_url")
  unlockOffsetHours Int       @default(0) @map("unlock_offset_hours")
  unlockAt          DateTime? @map("unlock_at")
  unlockKey         String    @map("unlock_key")
  /// Per-module override of the funnel's access window (hours). Null = the funnel's.
  accessHours       Int?      @map("access_hours")
  /// Show the funnel's offer section under this module.
  showOffer         Boolean   @default(true) @map("show_offer")
  isLive            Boolean   @default(false) @map("is_live")
  liveStartAt       DateTime? @map("live_start_at")
  liveEndAt         DateTime? @map("live_end_at")
  liveUrl           String?   @map("live_url")
  /// auto | on | off
  liveOverride      String    @default("auto") @map("live_override")
  resourcesHeading  String    @default("Resources") @map("resources_heading")
  /// [{ label, url }]
  resources         Json      @default("[]")
  /// none | always | video_time | datetime
  ctaReveal         String    @default("none") @map("cta_reveal")
  ctaText           String    @default("") @map("cta_text")
  ctaUrl            String    @default("") @map("cta_url")
  ctaSeconds        Int       @default(0) @map("cta_seconds")
  ctaAt             DateTime? @map("cta_at")
  ctaSubtext        String    @default("") @map("cta_subtext")
  /// video | text (a rich text module in place of the video box; live days keep the video box)
  kind              String    @default("video")
  /// Per-module override of the funnel's locked message.
  lockedMessage     String?   @map("locked_message")
  /// Per-session Add to calendar link (calendar mode "url").
  calendarUrl       String?   @map("calendar_url")
  /// Show the agenda in a box below this module's video box.
  showAgenda        Boolean   @default(false) @map("show_agenda")
  /// full | module
  agendaScope       String    @default("full") @map("agenda_scope")
  /// default | custom | off
  livendarMode      String    @default("default") @map("livendar_mode")
  livendarHtml      String    @default("") @map("livendar_html")
  ctaBg             String?   @map("cta_bg")
  ctaTextColor      String?   @map("cta_text_color")
  ctaNewTab         Boolean   @default(false) @map("cta_new_tab")
  /// SMS signup form (funnel_sms_forms id) shown under the video.
  smsFormId         String?   @map("sms_form_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  funnel            Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([organizationId, funnelId, position])
  @@map("funnel_days")
}

/// A host shown on the waitlist and in the home page "Meet your hosts" block.
model FunnelHost {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  funnelId       String   @map("funnel_id") @db.Uuid
  position       Int
  name           String   @default("")
  title          String   @default("")
  /// Sanitized rich text.
  bioHtml        String   @default("") @map("bio_html")
  photoAssetId   String?  @map("photo_asset_id") @db.Uuid
  photoUrl       String?  @map("photo_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  funnel         Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([organizationId, funnelId, position])
  @@map("funnel_hosts")
}

/// A non-module entry in the navigation: a custom page, an external link or a
/// "coming soon" placeholder. Never progression-locked.
model FunnelNavItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  funnelId       String   @map("funnel_id") @db.Uuid
  /// page | link | placeholder
  kind           String   @default("page")
  label          String   @default("")
  /// Pages: /l/<funnel>/p/<slug>. Unique per funnel (empty for links and placeholders).
  slug           String   @default("")
  title          String   @default("")
  /// Pages: rich (sanitized, in the content box) | html (raw, in a sandboxed iframe)
  contentMode    String   @default("rich") @map("content_mode")
  /// Pages: outside (above the box) | inside (top of the box) | hidden
  titlePlacement String   @default("outside") @map("title_placement")
  bodyHtml       String   @default("") @map("body_html")
  /// Raw admin HTML, only ever rendered inside a sandboxed iframe.
  html           String   @default("")
  /// Pages: none | email | form (an opt-in under the page)
  optinMode      String   @default("none") @map("optin_mode")
  optinFormSlug  String?  @map("optin_form_slug")
  /// Pages with optin_mode = "sms": a funnel_sms_forms id.
  smsFormId      String?  @map("sms_form_id") @db.Uuid
  url            String   @default("")
  newTab         Boolean  @default(true) @map("new_tab")
  showInNav      Boolean  @default(true) @map("show_in_nav")
  showLock       Boolean  @default(true) @map("show_lock")
  faded          Boolean  @default(true)
  showInAgenda   Boolean  @default(false) @map("show_in_agenda")
  /// Pages: shown at the funnel's front door instead of the waitlist / current module.
  isHome         Boolean  @default(false) @map("is_home")
  /// Placeholders: the agenda entry's title (empty = the label).
  agendaTitle    String   @default("") @map("agenda_title")
  agendaWhen     String   @default("") @map("agenda_when")
  agendaDesc     String   @default("") @map("agenda_desc")
  /// Shown after module N (0 = before the first); null = at the end.
  afterModule    Int?     @map("after_module")
  sort           Int      @default(0)
  thumbAssetId   String?  @map("thumb_asset_id") @db.Uuid
  thumbUrl       String?  @map("thumb_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  funnel         Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([organizationId, funnelId, sort])
  @@map("funnel_nav_items")
}

/// Logos and thumbnails in Postgres (no volume). Public: they render on public pages.
model FunnelAsset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// The funnel (or Mini-Blog site) that owns it.
  ownerId        String   @map("owner_id") @db.Uuid
  /// logo | thumb | header_bg | page_bg | footer_logo | host | block | nav_thumb
  kind           String
  filename       String
  mimeType       String   @map("mime_type")
  size           Int
  data           Bytes
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, ownerId])
  @@map("funnel_assets")
}

/// First-party funnel analytics: page views and CTA clicks. Admin previews are never recorded.
model FunnelEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  funnelId       String   @map("funnel_id") @db.Uuid
  /// Null = the waitlist / front door.
  dayId          String?  @map("day_id") @db.Uuid
  /// view | cta | resource | next | prev | calendar | live_join | live_redirect | early_join | today_training | nav_link | agenda_link | deadline_bar | close_button | home_button
  kind           String
  /// waitlist | home | day | close | custom (null on older rows)
  page           String?
  /// The clicked thing: resource "<index>|<label>|<url>", buttons their label.
  target         String?
  /// mobile | tablet | desktop
  device         String?
  /// Random id from the viewer cookie. Not linked to any person.
  visitorId      String   @map("visitor_id")
  /// Why this looks automated (user_agent | datacenter | webdriver); null = a person. Stats leave these out by default.
  botReason      String?  @map("bot_reason")
  /// The visitor's tracked URL parameters (org Funnels settings), e.g. {"utm_source":"fb"}. Null = none.
  params         Json?
  createdAt      DateTime @default(now()) @map("created_at")
  funnel         Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([organizationId, funnelId, createdAt])
  @@index([organizationId, funnelId, kind])
  @@map("funnel_events")
}

/// Highest watched percent per viewer per day.
model FunnelWatch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  funnelId       String   @map("funnel_id") @db.Uuid
  dayId          String   @map("day_id") @db.Uuid
  visitorId      String   @map("visitor_id")
  percent        Int
  updatedAt      DateTime @updatedAt @map("updated_at")
  funnel         Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, dayId, visitorId])
  @@index([organizationId, funnelId])
  @@map("funnel_watches")
}

/// Waitlist email capture (when the funnel does not reuse a Form). PII.
model FunnelOptin {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  funnelId       String   @map("funnel_id") @db.Uuid
  email          String
  /// The exact consent sentence the page showed.
  consentText    String   @map("consent_text")
  ipHash         String?  @map("ip_hash")
  pageUrl        String?  @map("page_url")
  /// Set from the unsubscribe link in an invite or reminder. No further emails.
  unsubscribedAt DateTime? @map("unsubscribed_at")
  /// The visitor's tracked URL parameters when they opted in. Null = none.
  params         Json?
  createdAt      DateTime @default(now()) @map("created_at")
  funnel         Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  sends          FunnelEmailSend[]

  @@unique([funnelId, email])
  @@index([organizationId, funnelId, createdAt])
  @@map("funnel_optins")
}

/// An email template: the registration confirmation (kind confirm) or a reminder
/// sent a set time before each live session (kind reminder).
model FunnelEmail {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  funnelId       String            @map("funnel_id") @db.Uuid
  /// confirm | reminder
  kind           String
  enabled        Boolean           @default(true)
  /// Reminders: minutes before each session starts.
  offsetMinutes  Int               @default(0) @map("offset_minutes")
  /// Merge tags allowed (modules/funnels/emails.ts).
  subject        String            @default("")
  /// Sanitized rich text with merge tags.
  bodyHtml       String            @default("") @map("body_html")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  funnel         Funnel            @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  sends          FunnelEmailSend[]

  @@index([organizationId, funnelId])
  @@map("funnel_emails")
}

/// One email sent (or attempted) to one opt-in. The unique key makes every send idempotent.
model FunnelEmailSend {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  funnelId       String      @map("funnel_id") @db.Uuid
  emailId        String      @map("email_id") @db.Uuid
  optinId        String      @map("optin_id") @db.Uuid
  /// The session it was about: a day id, "start", or "" for the confirmation.
  sessionKey     String      @default("") @map("session_key")
  /// sent | logged (email not set up) | failed
  status         String
  error          String?
  createdAt      DateTime    @default(now()) @map("created_at")
  funnel         Funnel      @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  email          FunnelEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)
  optin          FunnelOptin @relation(fields: [optinId], references: [id], onDelete: Cascade)

  @@unique([emailId, optinId, sessionKey])
  @@index([organizationId, funnelId, createdAt])
  @@map("funnel_email_sends")
}

/// An SMS opt-in form (phone + consent), placed on the waitlist, a home page
/// block, a day or a custom page. No SMS is sent: there is no provider yet.
model FunnelSmsForm {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  funnelId         String           @map("funnel_id") @db.Uuid
  name             String           @default("SMS signup")
  headline         String           @default("Get text alerts")
  /// Sanitized rich text above the fields.
  introHtml        String           @default("") @map("intro_html")
  collectEmail     Boolean          @default(false) @map("collect_email")
  phonePlaceholder String           @default("Mobile number") @map("phone_placeholder")
  buttonText       String           @default("Sign me up") @map("button_text")
  successMessage   String           @default("You're in. Watch your phone for a confirmation text.") @map("success_message")
  companyName      String           @default("") @map("company_name")
  programName      String           @default("") @map("program_name")
  messageFrequency String           @default("Message frequency varies") @map("message_frequency")
  helpContact      String           @default("") @map("help_contact")
  privacyUrl       String?          @map("privacy_url")
  termsUrl         String?          @map("terms_url")
  /// Plain-text consent; empty = the standard wording built from the fields above.
  customConsent    String           @default("") @map("custom_consent")
  boxBg            String           @default("#111827") @map("box_bg")
  textColor        String           @default("#ffffff") @map("text_color")
  buttonBg         String           @default("#1d4ed8") @map("button_bg")
  buttonColor      String           @default("#ffffff") @map("button_color")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  funnel           Funnel           @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  optins           FunnelSmsOptin[]

  @@index([organizationId, funnelId])
  @@map("funnel_sms_forms")
}

/// An SMS opt-in with the exact consent text shown. Append-only. PII.
model FunnelSmsOptin {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  funnelId       String        @map("funnel_id") @db.Uuid
  formId         String        @map("form_id") @db.Uuid
  /// E.164
  phone          String
  email          String?
  consentText    String        @map("consent_text")
  ipHash         String?       @map("ip_hash")
  pageUrl        String?       @map("page_url")
  userAgent      String?       @map("user_agent")
  /// The visitor's tracked URL parameters when they signed up. Null = none.
  params         Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  funnel         Funnel        @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  form           FunnelSmsForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([organizationId, funnelId, createdAt])
  @@index([formId, phone])
  @@map("funnel_sms_optins")
}

/// A member who may edit this one funnel without the funnels.write permission.
model FunnelDelegate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  funnelId       String   @map("funnel_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  addedById      String?  @map("added_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  funnel         Funnel   @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, userId])
  @@index([organizationId, userId])
  @@map("funnel_delegates")
}

/// Organization-wide Funnels settings (Funnels → Settings, funnels.publish): the URL parameters
/// every funnel in the org tracks, and whether a visitor keeps their first or latest values.
model FunnelsSettings {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  trackedParams  String[] @default(["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"]) @map("tracked_params")
  /// first | last
  attribution    String   @default("first")
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("funnels_settings")
}
