// Intel tables: competitor intelligence (competitors, their emails, Gmail inboxes, the weekly Promo Radar).
// Foreign keys to organizations and brands are added by hand in the migration (ON DELETE CASCADE).

/// A competing publisher this brand watches.
model IntelCompetitor {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  brandId         String       @map("brand_id") @db.Uuid
  name            String
  /// Their brands, newsletters and products.
  products        String[]     @default([])
  websites        String[]     @default([])
  /// Exact sender addresses, lowercased.
  senderAddresses String[]     @default([]) @map("sender_addresses")
  /// Sender domains, lowercased. A subdomain of one matches too.
  senderDomains   String[]     @default([]) @map("sender_domains")
  notes           String?
  tags            String[]     @default([])
  createdById     String?      @map("created_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")
  emails          IntelEmail[]
  videos          IntelVideo[]

  @@index([organizationId, brandId])
  @@map("intel_competitors")
}

/// One competitor email in a brand's inbox. The original message is kept in `raw`.
model IntelEmail {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  brandId          String             @map("brand_id") @db.Uuid
  competitorId     String?            @map("competitor_id") @db.Uuid
  /// How the competitor was matched: address, domain, website, manual.
  matchedBy        String?            @map("matched_by")
  /// upload, mbox, paste, gmail
  source           String
  gmailAccountId   String?            @map("gmail_account_id") @db.Uuid
  gmailMessageId   String?            @map("gmail_message_id")
  messageId        String?            @map("message_id")
  /// Message-ID, Gmail id or a content hash; one copy per brand.
  dedupeKey        String             @map("dedupe_key")
  subject          String
  fromName         String?            @map("from_name")
  fromAddress      String             @map("from_address")
  toAddress        String?            @map("to_address")
  receivedAt       DateTime           @map("received_at")
  htmlBody         String?            @map("html_body")
  textBody         String             @default("") @map("text_body")
  snippet          String             @default("")
  /// Links found in the body: [{ href, text }].
  links            Json               @default("[]")
  landingUrl       String?            @map("landing_url")
  /// Gmail tab or folder (PRIMARY, PROMOTIONS, SPAM ...), when known.
  placement        String?
  raw              Bytes?
  rawSize          Int                @default(0) @map("raw_size")
  /// Copied from the extraction so the inbox can filter on it.
  emailType        String?            @map("email_type")
  /// NONE, QUEUED, RUNNING, DONE, FAILED
  extractionStatus String             @default("NONE") @map("extraction_status")
  extractionError  String?            @map("extraction_error")
  extraction       Json?
  extractionModel  String?            @map("extraction_model")
  extractedAt      DateTime?          @map("extracted_at")
  /// The Promo Analyzer promo made from this email, if any.
  analyzerPromoId  String?            @map("analyzer_promo_id") @db.Uuid
  /// The fetched landing page (text only), when one was captured.
  landingPageId    String?            @map("landing_page_id") @db.Uuid
  createdById      String?            @map("created_by_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")
  competitor       IntelCompetitor?   @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  gmailAccount     IntelGmailAccount? @relation(fields: [gmailAccountId], references: [id], onDelete: SetNull)
  landingPage      IntelLandingPage?  @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  entityRefs       IntelEntityRef[]

  @@unique([brandId, dedupeKey])
  @@index([organizationId, brandId, receivedAt])
  @@index([organizationId, brandId, competitorId])
  @@index([organizationId, extractionStatus])
  @@map("intel_emails")
}

/// A Gmail inbox subscribed to competitor lists. Tokens are encrypted with AUTH_SECRET.
model IntelGmailAccount {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  brandId          String       @map("brand_id") @db.Uuid
  email            String
  refreshTokenEnc  String       @map("refresh_token_enc")
  accessTokenEnc   String?      @map("access_token_enc")
  tokenExpiresAt   DateTime?    @map("token_expires_at")
  /// Gmail search filter, e.g. "label:competitors". Blank = the whole inbox.
  query            String?
  historyId        String?      @map("history_id")
  /// IDLE, RUNNING
  syncStatus       String       @default("IDLE") @map("sync_status")
  lastSyncAt       DateTime?    @map("last_sync_at")
  lastSyncError    String?      @map("last_sync_error")
  lastSyncAdded    Int          @default(0) @map("last_sync_added")
  connectedById    String?      @map("connected_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  emails           IntelEmail[]

  @@unique([brandId, email])
  @@index([organizationId])
  @@map("intel_gmail_accounts")
}

/// The Promo Radar for one brand and one week (Monday, UTC).
model IntelRadarDigest {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  weekStart      DateTime  @map("week_start") @db.Date
  /// Deterministic grouping of the week's emails (see modules/intel/radar.ts).
  summary        Json
  /// NONE, QUEUED, RUNNING, DONE, FAILED (the AI narrative)
  status         String    @default("NONE")
  error          String?
  narrative      Json?
  model          String?
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([brandId, weekStart])
  @@index([organizationId, brandId])
  @@map("intel_radar_digests")
}

/// A competitor video (VSL, webinar replay, YouTube, Vimeo, Wistia...) captured from a page URL.
/// The video itself is never kept: only the transcript, a few small keyframes and the AI extraction.
model IntelVideo {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  brandId          String            @map("brand_id") @db.Uuid
  competitorId     String?           @map("competitor_id") @db.Uuid
  /// website (page host matched a competitor) or manual.
  matchedBy        String?           @map("matched_by")
  /// The URL someone pasted.
  url              String
  /// The media URL handed to the downloader (an embed found on the page, or the page itself).
  mediaUrl         String?           @map("media_url")
  /// youtube, vimeo, wistia, vidalytics, brightcove, other
  platform         String?
  title            String?
  uploader         String?
  durationSec      Int?              @map("duration_sec")
  thumbnailUrl     String?           @map("thumbnail_url")
  /// QUEUED, RUNNING, DONE, FAILED
  status           String            @default("QUEUED")
  /// The pipeline step while RUNNING: page, download, audio, transcribe, frames, extract.
  step             String?
  error            String?
  attempts         Int               @default(0)
  transcript       String            @default("")
  /// captions, whisper, revai
  transcriptSource String?           @map("transcript_source")
  landingPageId    String?           @map("landing_page_id") @db.Uuid
  /// Copied from the extraction so lists can filter on it.
  videoType        String?           @map("video_type")
  /// NONE, QUEUED, RUNNING, DONE, FAILED
  extractionStatus String            @default("NONE") @map("extraction_status")
  extractionError  String?           @map("extraction_error")
  extraction       Json?
  extractionModel  String?           @map("extraction_model")
  extractedAt      DateTime?         @map("extracted_at")
  analyzerPromoId  String?           @map("analyzer_promo_id") @db.Uuid
  /// Set on the admin console's copy (VidRipper) of a video captured in another organization: the original video's id.
  copiedFromId     String?           @map("copied_from_id") @db.Uuid
  startedAt        DateTime?         @map("started_at")
  finishedAt       DateTime?         @map("finished_at")
  createdById      String?           @map("created_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  competitor       IntelCompetitor?  @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  landingPage      IntelLandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  frames           IntelVideoFrame[]
  entityRefs       IntelEntityRef[]

  @@index([organizationId, brandId, createdAt])
  @@index([status, createdAt])
  @@index([copiedFromId])
  @@map("intel_videos")
}

/// A small JPEG keyframe from a captured video.
model IntelVideoFrame {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  videoId        String     @map("video_id") @db.Uuid
  position       Int
  atSec          Int        @map("at_sec")
  data           Bytes
  size           Int
  createdAt      DateTime   @default(now()) @map("created_at")
  video          IntelVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, position])
  @@index([organizationId])
  @@map("intel_video_frames")
}

/// A competitor landing page, fetched once (text only, no screenshot) and shared by every email or video that links to it.
model IntelLandingPage {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  brandId        String       @map("brand_id") @db.Uuid
  /// The URL we were asked to fetch (after tracker unwrapping).
  url            String
  /// Where redirects ended.
  finalUrl       String?      @map("final_url")
  /// OK, FAILED
  status         String
  httpStatus     Int?         @map("http_status")
  title          String?
  description    String?
  headings       String[]     @default([])
  text           String       @default("")
  /// Links on the page: [{ href, text, count }].
  links          Json         @default("[]")
  error          String?
  fetchedAt      DateTime     @default(now()) @map("fetched_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  emails         IntelEmail[]
  videos         IntelVideo[]

  @@unique([brandId, url])
  @@index([organizationId, brandId])
  @@map("intel_landing_pages")
}

/// Registries: experts (gurus), lists (sender lists / newsletters) and topics.
model IntelEntity {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  brandId        String           @map("brand_id") @db.Uuid
  /// expert, list, topic
  kind           String
  name           String
  /// Other spellings (and, for lists, sender addresses) that resolve to this entry.
  aliases        String[]         @default([])
  /// The publisher an expert writes for or a list belongs to.
  competitorId   String?          @map("competitor_id") @db.Uuid
  /// Lists only: free, paid, hotlist, marketing.
  category       String?
  notes          String?
  /// Ignored entries keep their links (so they are not re-created) but are hidden from filters and counts.
  ignored        Boolean          @default(false)
  autoCreated    Boolean          @default(true) @map("auto_created")
  mergedIntoId   String?          @map("merged_into_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  refs           IntelEntityRef[]

  @@index([organizationId, brandId, kind])
  @@map("intel_entities")
}

/// Which email or video mentions which registry entry.
model IntelEntityRef {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  entityId       String      @map("entity_id") @db.Uuid
  emailId        String?     @map("email_id") @db.Uuid
  videoId        String?     @map("video_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  entity         IntelEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  email          IntelEmail? @relation(fields: [emailId], references: [id], onDelete: Cascade)
  video          IntelVideo? @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([entityId, emailId])
  @@unique([entityId, videoId])
  @@index([organizationId])
  @@index([emailId])
  @@index([videoId])
  @@map("intel_entity_refs")
}

/// Per-brand Intel settings: the weekly digest and landing-page capture.
model IntelSettings {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  brandId          String    @map("brand_id") @db.Uuid
  digestEnabled    Boolean   @default(false) @map("digest_enabled")
  /// Slack incoming webhook URL, encrypted with AUTH_SECRET.
  slackWebhookEnc  String?   @map("slack_webhook_enc")
  /// Team members who asked for the digest by email.
  digestEmails     String[]  @default([]) @map("digest_emails")
  /// Fetch each email's landing page (text) before extraction.
  autoLanding      Boolean   @default(true) @map("auto_landing")
  lastDigestWeek   DateTime? @map("last_digest_week") @db.Date
  lastDigestAt     DateTime? @map("last_digest_at")
  lastDigestError  String?   @map("last_digest_error")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([brandId])
  @@index([organizationId])
  @@map("intel_settings")
}
