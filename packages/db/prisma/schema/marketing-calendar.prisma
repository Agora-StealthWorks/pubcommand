// Marketing Calendar tables (module id "editorial"). Every row belongs to one brand.
// Calendar days are stored as DATE (no time zone); event times are "HH:mm" strings.

// CalendarPublication (table calendar_publications) moved to pubsetup.prisma:
// Publication Setup owns publications now. Same model name, table and columns.

/// An optional channel or room an event runs in (webinar room, livestream, podcast feed...).
model CalendarChannel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  name           String
  color          String   @default("#27455c")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([brandId, name])
  @@index([organizationId, brandId])
  @@map("calendar_channels")
}

/// A recurring event: shared copy plus a cadence that generates CalendarEvent occurrences.
model CalendarSeries {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  brandId        String          @map("brand_id") @db.Uuid
  name           String
  frequency      String
  startsOn       DateTime        @map("starts_on") @db.Date
  until          DateTime?       @db.Date
  active         Boolean         @default(true)
  profile        Json?
  /// When the extension job last planned this series ahead.
  extendedAt     DateTime?       @map("extended_at")
  deletedAt      DateTime?       @map("deleted_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  occurrences    CalendarEvent[]

  @@index([organizationId, brandId])
  @@map("calendar_series")
}

/// A live event. Its three stages run marketingStart -> eventDate..eventEnd -> marketingEnd.
model CalendarEvent {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  brandId        String          @map("brand_id") @db.Uuid
  name           String
  eventType      String?         @map("event_type")
  format         String?
  stage          String          @default("Idea")
  marketingStart DateTime?       @map("marketing_start") @db.Date
  eventDate      DateTime?       @map("event_date") @db.Date
  eventEnd       DateTime?       @map("event_end") @db.Date
  marketingEnd   DateTime?       @map("marketing_end") @db.Date
  startTime      String?         @map("start_time")
  endTime        String?         @map("end_time")
  channels       String[]        @default([])
  hosts          String[]        @default([])
  offer          String?
  promoCode      String?         @map("promo_code")
  ctaLink        String?         @map("cta_link")
  registrationLink String?       @map("registration_link")
  replayLink     String?         @map("replay_link")
  notes          String?
  peakAttendance Int?            @map("peak_attendance")
  avgAttendance  Int?            @map("avg_attendance")
  registrations  Int?
  newSubscribers Int?            @map("new_subscribers")
  leads          Int?
  orders         Int?
  revenue        Float?
  messages       Int?
  seriesId       String?         @map("series_id") @db.Uuid
  series         CalendarSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  /// Promo Analyzer promo this event is built around (promos.id).
  promoId        String?         @map("promo_id") @db.Uuid
  /// The calendar's own promo (calendar_promos.id). Replaces promoId, which is no longer read.
  calendarPromoId String?        @map("calendar_promo_id") @db.Uuid
  airtableId     String?         @map("airtable_id")
  /// Last successful write-back or pull for this row.
  airtableSyncedAt DateTime?     @map("airtable_synced_at")
  brainTaughtAt  DateTime?       @map("brain_taught_at")
  createdById    String?         @map("created_by_id") @db.Uuid
  updatedById    String?         @map("updated_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")

  @@index([organizationId, brandId, eventDate])
  @@index([seriesId])
  @@index([brandId, airtableId])
  @@index([promoId])
  @@index([calendarPromoId])
  @@map("calendar_events")
}

/// One editorial issue of a publication.
model CalendarIssue {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  brandId         String             @map("brand_id") @db.Uuid
  publicationCode String             @map("publication_code")
  mailDate        DateTime?          @map("mail_date") @db.Date
  title           String
  subjectLines    String[]           @default([]) @map("subject_lines")
  status          String             @default("Planned")
  issueType       String?            @map("issue_type")
  writer          String?
  body            String?
  notes           String?
  websiteLink     String?            @map("website_link")
  ctaLink         String?            @map("cta_link")
  offer           String?
  tickers         String[]           @default([])
  promoId         String?            @map("promo_id") @db.Uuid
  /// The calendar's own promo (calendar_promos.id). Replaces promoId, which is no longer read.
  calendarPromoId String?            @map("calendar_promo_id") @db.Uuid
  airtableId      String?            @map("airtable_id")
  airtableSyncedAt DateTime?         @map("airtable_synced_at")
  brainTaughtAt   DateTime?          @map("brain_taught_at")
  createdById     String?            @map("created_by_id") @db.Uuid
  updatedById     String?            @map("updated_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")
  stat            CalendarSendStat?

  @@index([organizationId, brandId, mailDate])
  @@index([brandId, publicationCode])
  @@index([brandId, airtableId])
  @@index([promoId])
  @@index([calendarPromoId])
  @@map("calendar_issues")
}

/// ESP send stats matched onto one issue. Rates are ratios (0.0423 = 4.23%).
model CalendarSendStat {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  issueId        String        @unique @map("issue_id") @db.Uuid
  issue          CalendarIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  importId       String?       @map("import_id") @db.Uuid
  listLabel      String?       @map("list_label")
  pubCode        String?       @map("pub_code")
  mailDate       DateTime?     @map("mail_date") @db.Date
  subject        String?
  delivered      Int?
  openRate       Float?        @map("open_rate")
  clickRate      Float?        @map("click_rate")
  clickToOpen    Float?        @map("click_to_open")
  revenue        Float?
  totalOpened    Int?          @map("total_opened")
  totalClicked   Int?          @map("total_clicked")
  unsubscribes   Int?
  complaints     Int?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([organizationId, pubCode, mailDate])
  @@map("calendar_send_stats")
}

/// One CSV upload of send stats, with what did and did not match.
model CalendarStatImport {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  filename       String
  rowsParsed     Int      @default(0) @map("rows_parsed")
  matched        Int      @default(0)
  unmatched      Int      @default(0)
  unmatchedRows  Json?    @map("unmatched_rows")
  mapping        Json?
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, brandId, createdAt])
  @@map("calendar_stat_imports")
}

/// A stored "What's Working" AI summary of the last N days of sends.
model CalendarInsight {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  windowDays     Int       @default(30) @map("window_days")
  status         String    @default("QUEUED")
  error          String?
  model          String?
  facts          Json?
  content        Json?
  issueCount     Int       @default(0) @map("issue_count")
  dataFrom       DateTime? @map("data_from") @db.Date
  dataTo         DateTime? @map("data_to") @db.Date
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, brandId, createdAt])
  @@map("calendar_insights")
}

/// A CUB peer-review round on a promo draft. Public pages are gated by the two tokens.
model CalendarCubRound {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  brandId        String              @map("brand_id") @db.Uuid
  promoName      String              @map("promo_name")
  instructions   String?
  draftFilename  String              @map("draft_filename")
  draftMime      String              @map("draft_mime")
  draftSize      Int                 @map("draft_size")
  draftData      Bytes               @map("draft_data")
  dueAt          DateTime            @map("due_at")
  reviewToken    String              @unique @map("review_token")
  ownerToken     String              @unique @map("owner_token")
  closedAt       DateTime?           @map("closed_at")
  promoId        String?             @map("promo_id") @db.Uuid
  /// The calendar's own promo (calendar_promos.id). Replaces promoId, which is no longer read.
  calendarPromoId String?            @map("calendar_promo_id") @db.Uuid
  initiatorEmail String?             @map("initiator_email")
  initiatorName  String?             @map("initiator_name")
  reviewerEmails String[]            @default([]) @map("reviewer_emails")
  /// Origin the public links were made on ("https://acme.example.com"), for emails sent by the job.
  publicBase     String?             @map("public_base")
  requestSentAt  DateTime?           @map("request_sent_at")
  /// Idempotency stamps for the job: the 9:05 am ET reminder and the post-deadline email.
  reminderSentAt DateTime?           @map("reminder_sent_at")
  deadlineNotifiedAt DateTime?       @map("deadline_notified_at")
  createdById    String?             @map("created_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  reviews        CalendarCubReview[]

  @@index([organizationId, brandId, createdAt])
  @@map("calendar_cub_rounds")
}

/// One reviewer's marked-up file plus four 0-10 scores (only averages are ever shown).
model CalendarCubReview {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  roundId        String           @map("round_id") @db.Uuid
  round          CalendarCubRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  reviewerName   String           @map("reviewer_name")
  filename       String
  mimeType       String           @map("mime_type")
  size           Int
  data           Bytes
  scoreHeadline  Int              @map("score_headline")
  scoreStory     Int              @map("score_story")
  scoreOffer     Int              @map("score_offer")
  scoreOverall   Int              @map("score_overall")
  comments       String?
  submittedAt    DateTime         @default(now()) @map("submitted_at")

  @@index([organizationId, roundId])
  @@map("calendar_cub_reviews")
}

/// An editable email template per kind (cub-request, cub-reminder, cub-owner-confirm, cub-complete).
/// No row means the built-in default. `recipients` is the saved reviewer group (cub-request only).
model CalendarEmailTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  kind           String
  subject        String
  body           String
  recipients     String[] @default([])
  enabled        Boolean  @default(true)
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([brandId, kind])
  @@index([organizationId, brandId])
  @@map("calendar_email_templates")
}

/// One email the calendar tried to send (recipient count only, never the body).
model CalendarEmailLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  kind           String
  roundId        String?  @map("round_id") @db.Uuid
  recipients     Int      @default(0)
  /// sent | logged (no RESEND_API_KEY) | failed | skipped
  status         String
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, brandId, createdAt])
  @@index([roundId])
  @@map("calendar_email_logs")
}

/// A remembered send-stat list label → publication code. An empty pubCode means "ignore this list".
model CalendarListMapping {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  /// Normalized label (trimmed, lower case, single spaces); the lookup key.
  labelKey       String   @map("label_key")
  label          String
  pubCode        String   @default("") @map("pub_code")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([brandId, labelKey])
  @@index([organizationId, brandId])
  @@map("calendar_list_mappings")
}

/// An admin-editable dropdown value for one field (event.stage, event.type, event.format,
/// issue.status, issue.type, promo.stage). No rows for a field means the built-in defaults.
model CalendarFieldOption {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  field          String
  value          String
  color          String?
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([brandId, field, value])
  @@index([organizationId, brandId, field])
  @@map("calendar_field_options")
}

/// The calendar's own promos (independent of Promo Analyzer): the pipeline board, the promo
/// picker on events and issues, and launch events. Publication and editors come from Publication Setup.
model CalendarPromo {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  brandId            String    @map("brand_id") @db.Uuid
  name               String
  /// Front-end | Mid-tier | Back-end | Renewal (free text).
  promoType          String?   @map("promo_type")
  stage              String    @default("Idea")
  writers            String[]  @default([])
  format             String?
  /// Publication code from Publication Setup.
  product            String?
  /// Editor names from Publication Setup.
  gurus              String[]  @default([])
  notes              String?
  targetedDate       DateTime? @map("targeted_date") @db.Date
  launchDate         DateTime? @map("launch_date") @db.Date
  launchEstimated    Boolean   @default(false) @map("launch_estimated")
  copyPlatformUrl    String?   @map("copy_platform_url")
  hotlistPageUrl     String?   @map("hotlist_page_url")
  promoFileUrl       String?   @map("promo_file_url")
  cubDraftUrl        String?   @map("cub_draft_url")
  copyPlatform       Json?     @map("copy_platform")
  /// The launch event made from this promo; set once so a deleted launch event is never re-created.
  launchEventId      String?   @map("launch_event_id") @db.Uuid
  launchEventCreated Boolean   @default(false) @map("launch_event_created")
  airtableId         String?   @map("airtable_id")
  /// The Promo Analyzer promo this row was copied from by the one-time backfill (never read by the app).
  legacyPromoId      String?   @unique @map("legacy_promo_id") @db.Uuid
  createdById        String?   @map("created_by_id") @db.Uuid
  updatedById        String?   @map("updated_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  activity           CalendarPromoActivity[]

  @@index([organizationId, brandId, stage])
  @@index([brandId, launchDate])
  @@map("calendar_promos")
}

/// History of a calendar promo: created, stage changes, date changes and other tracked fields.
model CalendarPromoActivity {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  promoId        String        @map("promo_id") @db.Uuid
  promo          CalendarPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  /// created | stage | launchDate | targetedDate | field | launchEvent
  kind           String
  field          String?
  fromValue      String?       @map("from_value")
  toValue        String?       @map("to_value")
  note           String?
  actorId        String?       @map("actor_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([organizationId, promoId, createdAt])
  @@map("calendar_promo_activity")
}

/// UNUSED since calendar_own_promos: the old pipeline row per Promo Analyzer promo. Kept (additive policy).
model CalendarPromoTrack {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  promoId        String    @unique @map("promo_id") @db.Uuid
  stage          String    @default("Idea")
  launchDate     DateTime? @map("launch_date") @db.Date
  launchEstimated Boolean  @default(false) @map("launch_estimated")
  writers        String[]  @default([])
  notes          String?
  updatedById    String?   @map("updated_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, brandId, stage])
  @@map("calendar_promo_tracks")
}

/// Prices for a ticker mentioned in an issue, as of the issue's mail date (finance brands).
model CalendarTickerPrice {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  ticker         String
  issueDate      DateTime  @map("issue_date") @db.Date
  issueClose     Float?    @map("issue_close")
  peak           Float?
  peakPct        Float?    @map("peak_pct")
  current        Float?
  currentPct     Float?    @map("current_pct")
  source         String?
  error          String?
  fetchedAt      DateTime? @map("fetched_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([brandId, ticker, issueDate])
  @@index([organizationId, brandId])
  @@map("calendar_ticker_prices")
}

/// The brand's own Airtable base for optional two-way sync. The token is encrypted with AUTH_SECRET.
model CalendarAirtableConnection {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  brandId        String    @unique @map("brand_id") @db.Uuid
  baseId         String    @map("base_id")
  tokenEnc       String    @map("token_enc")
  eventsTable    String?   @map("events_table")
  issuesTable    String?   @map("issues_table")
  /// { calendarField: "Airtable field name" } per table.
  eventFields    Json?     @map("event_fields")
  issueFields    Json?     @map("issue_fields")
  /// Airtable field names that are computed (formula, rollup...) and never written.
  readOnlyFields String[]  @default([]) @map("read_only_fields")
  enabled        Boolean   @default(true)
  lastPullAt     DateTime? @map("last_pull_at")
  lastStatus     String?   @map("last_status")
  lastError      String?   @map("last_error")
  updatedById    String?   @map("updated_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("calendar_airtable_connections")
}

/// Airtable sync observability: one row per push or pull outcome.
model CalendarSyncLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  /// push | pull
  direction      String
  /// event | issue
  entity         String
  recordId       String?  @map("record_id") @db.Uuid
  airtableId     String?  @map("airtable_id")
  /// ok | error | skipped
  status         String
  message        String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, brandId, createdAt])
  @@map("calendar_sync_logs")
}
