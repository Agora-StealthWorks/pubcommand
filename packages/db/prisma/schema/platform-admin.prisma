// Platform admin console: per-organization app access set by PubCommand staff,
// and per-member app access set by an organization's admins.

enum AppAccessOverride {
  ALLOWED
  BLOCKED
}

enum MemberAppLevel {
  NONE
  VIEW
  EDIT
}

/// Staff override of the plan for one organization and one app. Wins over the plan.
/// The column is organization_id, but the field is deliberately NOT `organizationId`:
/// that keeps the model off the tenant client, so organization code cannot write it.
/// RLS lets an organization read its own rows; only bypass_rls (platform code) writes.
model OrganizationAppAccess {
  orgId       String            @map("organization_id") @db.Uuid
  moduleId    String            @map("module_id")
  access      AppAccessOverride
  updatedById String?           @map("updated_by_id") @db.Uuid
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at")

  @@id([orgId, moduleId])
  @@map("organization_app_access")
}

/// One member's access to one app, set in Settings → Users. Missing row = role default.
model MemberAppAccess {
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  moduleId       String         @map("module_id")
  level          MemberAppLevel
  updatedById    String?        @map("updated_by_id") @db.Uuid
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  @@id([organizationId, userId, moduleId])
  @@index([organizationId])
  @@map("member_app_access")
}

/// Platform-wide settings set by PubCommand staff in the admin console, one JSON value per key.
/// Not a tenant table (no organizationId). Keys: "default_apps" = { enabled: string[] }.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// How one app shows up as a card on organization dashboards, set by staff in Admin → App cards.
/// Platform table (no organizationId). No row means the built-in defaults (apps/web/src/lib/apps.ts).
model AppCard {
  moduleId    String   @id @map("module_id")
  /// Card title on the dashboard. Null keeps the app's built-in name.
  name        String?
  /// Shown on dashboards of organizations that have the app. Null keeps the default
  /// (built-in apps on, apps without a built-in card off until staff turn them on).
  onDashboard Boolean? @map("on_dashboard")
  /// Dashboard order, lowest first. Null keeps the built-in order.
  position    Int?
  /// Uploaded card artwork (2:1, PNG, JPEG or WebP). Null uses the bundled default or a drawing.
  imageMime   String?  @map("image_mime")
  imageData   Bytes?   @map("image_data")
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_cards")
}
