// Promo Analyzer tables.
enum AnalysisStatus {
  NONE
  QUEUED
  RUNNING
  DONE
  FAILED
}


/// A sales letter / promo for one brand. The copy lives here; each AI pass is a PromoAnalysis.
model Promo {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  brandId            String         @map("brand_id") @db.Uuid
  title              String
  filename           String?
  inputType          String         @default("text") @map("input_type")
  sourceText         String         @default("") @map("source_text")
  publisher          String?
  gurus              String[]       @default([])
  product            String?
  promoType          String?        @map("promo_type")
  promoStatus        String?        @map("promo_status")
  promoCode          String?        @map("promo_code")
  runStartDate       DateTime?      @map("run_start_date") @db.Date
  pricePoint         Decimal?       @map("price_point") @db.Decimal(10, 2)
  analysisStatus     AnalysisStatus @default(NONE) @map("analysis_status")
  analysisError      String?        @map("analysis_error")
  /// The answer so far while an analysis streams (the live view polls it). Cleared when the run ends.
  analysisLive       String?        @map("analysis_live")
  analysisStartedAt  DateTime?      @map("analysis_started_at")
  effectivenessScore Float?         @map("effectiveness_score")
  fkReadingEase      Float?         @map("fk_reading_ease")
  fkGradeLevel       Float?         @map("fk_grade_level")
  myScore            Float?         @map("my_score")
  performanceScore   Float?         @map("performance_score")
  trainingNotes      String?        @map("training_notes")
  isBestPerformer    Boolean        @default(false) @map("is_best_performer")
  source             String?
  uploadedById       String?        @map("uploaded_by_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand              Brand          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  analyses           PromoAnalysis[]
  files              PromoFile[]

  @@index([organizationId, brandId, createdAt])
  @@map("promos")
}

/// One AI analysis run. Kept as history; the newest DONE row is the current one.
model PromoAnalysis {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  promoId        String       @map("promo_id") @db.Uuid
  version        Int
  model          String
  result         Json
  score          Float?
  inputTokens    Int          @default(0) @map("input_tokens")
  outputTokens   Int          @default(0) @map("output_tokens")
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promo          Promo        @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@unique([promoId, version])
  @@index([organizationId])
  @@map("promo_analyses")
}

/// The original upload and supporting files, stored in Postgres (no volume needed).
model PromoFile {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  promoId        String       @map("promo_id") @db.Uuid
  kind           String       @default("supplemental")
  category       String?
  filename       String
  mimeType       String       @map("mime_type")
  size           Int
  data           Bytes
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promo          Promo        @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@index([organizationId, promoId])
  @@map("promo_files")
}

/// One uploaded results sheet (CSV/XLSX). The file stays here until it is mapped and imported.
model PromoPerformanceImport {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  filename       String
  mimeType       String   @map("mime_type")
  size           Int
  data           Bytes
  /// MAPPING (waiting for column choices), DONE, FAILED.
  status         String   @default("MAPPING")
  error          String?
  headers        String[] @default([])
  mapping        Json?
  rowCount       Int      @default(0) @map("row_count")
  codeCount      Int      @default(0) @map("code_count")
  matchedCount   Int      @default(0) @map("matched_count")
  /// upload (a file someone chose) or sheet (the Google Sheets sync).
  source         String   @default("upload")
  /// SHA-256 of the imported table; a sheet sync with the same hash is skipped.
  contentHash    String?  @map("content_hash")
  /// The rows this import replaced, as they were before it ran: [{ codeKey, data }]. Undo puts them back.
  previous       Json?
  /// Codes this import created (no row existed before). Undo deletes them.
  createdCodes   String[] @default([]) @map("created_codes")
  undoneAt       DateTime? @map("undone_at")
  undoneById     String?  @map("undone_by_id") @db.Uuid
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, brandId, createdAt])
  @@map("promo_performance_imports")
}

/// Real-world results for one promo code in one brand (rows with the same code are summed).
model PromoPerformance {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  importId       String?   @map("import_id") @db.Uuid
  /// Normalized code used for matching (upper case, letters and digits only).
  codeKey        String    @map("code_key")
  promoCode      String    @map("promo_code")
  label          String?
  promoId        String?   @map("promo_id") @db.Uuid
  sheetType      String?   @map("sheet_type")
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  sent           Float?
  views          Float?
  clicks         Float?
  orders         Float?
  revenue        Float?
  cost           Float?
  extra          Json?
  /// Cohort and tier, recomputed from the whole brand's data after every import.
  cohort         String?
  cohortSize     Int?      @map("cohort_size")
  metric         String?
  metricValue    Float?    @map("metric_value")
  percentile     Float?
  tierScheme     String?   @map("tier_scheme")
  /// The tier shown everywhere: the override when a person set one, else computedTier.
  tier           String?
  /// The tier the data gives, before any override.
  computedTier   String?   @map("computed_tier")
  /// A person's tier (a TierKey, or "none" to show no tier). Survives every re-tier.
  tierOverride   String?   @map("tier_override")
  tierOverrideReason String? @map("tier_override_reason")
  tierOverrideById String? @map("tier_override_by_id") @db.Uuid
  tierOverrideAt DateTime? @map("tier_override_at")
  /// Linked to promoId by a person; re-matching by code never changes it.
  linkedManually Boolean   @default(false) @map("linked_manually")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([brandId, codeKey])
  @@index([organizationId, brandId])
  @@index([promoId])
  @@map("promo_performance")
}

/// A brand-level lesson theme: AI-clustered from analyses and results, or written by a person.
model PromoLesson {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  title          String
  body           String
  category       String    @default("other")
  /// ai or manual.
  origin         String    @default("ai")
  /// Distinct promos behind this theme (computed from data, not by the AI).
  evidenceCount  Int       @default(0) @map("evidence_count")
  promoIds       String[]  @default([]) @map("promo_ids")
  fromResults    Boolean   @default(false) @map("from_results")
  suggestedShared Boolean  @default(false) @map("suggested_shared")
  pinned         Boolean   @default(false)
  hidden         Boolean   @default(false)
  edited         Boolean   @default(false)
  sharedAt       DateTime? @map("shared_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, brandId])
  @@map("promo_lessons")
}

/// One lesson-clustering run, polled by the Lessons page.
model PromoLessonRun {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  status         String   @default("QUEUED")
  error          String?
  inputCount     Int      @default(0) @map("input_count")
  themeCount     Int      @default(0) @map("theme_count")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, brandId, createdAt])
  @@map("promo_lesson_runs")
}

/// A correction to the Directory: rename/merge/alias (toName set) or hide (hidden). Promos keep their detected values.
model PromoEntityOverride {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  /// publisher, guru or product.
  kind           String
  fromKey        String   @map("from_key")
  fromName       String   @map("from_name")
  toName         String?  @map("to_name")
  hidden         Boolean  @default(false)
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([brandId, kind, fromKey])
  @@index([organizationId, brandId])
  @@map("promo_entity_overrides")
}

/// One brand's Google Sheets sync of performance results. The service-account key is encrypted with AUTH_SECRET.
model PromoSheetSync {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  spreadsheetId  String    @map("spreadsheet_id")
  /// A1 range or tab name, e.g. "Results" or "Results!A1:Z".
  range          String    @default("Sheet1")
  /// AES-256-GCM encrypted service-account JSON. Never shown again after saving.
  credentials    String?
  clientEmail    String?   @map("client_email")
  headers        String[]  @default([])
  /// { field: header name }: survives columns moving around in the sheet.
  mapping        Json?
  enabled        Boolean   @default(false)
  everyHours     Int       @default(6) @map("every_hours")
  /// IDLE | RUNNING | OK | FAILED
  status         String    @default("IDLE")
  lastError      String?   @map("last_error")
  lastSyncAt     DateTime? @map("last_sync_at")
  lastHash       String?   @map("last_hash")
  lastImportId   String?   @map("last_import_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([brandId])
  @@index([organizationId])
  @@map("promo_sheet_syncs")
}

/// One promo waiting in (or done with) the bulk re-analysis queue. Survives restarts; a job drains it, two at a time.
model PromoBulkJob {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  promoId        String    @map("promo_id") @db.Uuid
  actorId        String?   @map("actor_id") @db.Uuid
  /// QUEUED | RUNNING | DONE | FAILED | CANCELLED
  status         String    @default("QUEUED")
  attempts       Int       @default(0)
  error          String?
  lockedAt       DateTime? @map("locked_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([organizationId, brandId, status])
  @@index([promoId])
  @@map("promo_bulk_jobs")
}
