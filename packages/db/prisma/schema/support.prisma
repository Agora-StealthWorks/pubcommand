// Support Knowledge (module `support`): what customer-facing support agents may say.
// Plain organization/brand columns; foreign keys are added by hand in the migration.

/// One customer-safe knowledge record. Category × audience decides which agents may read it.
model SupportRecord {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  brandId            String            @map("brand_id") @db.Uuid
  /// modules/support/taxonomy.ts CATEGORIES (never "trades": those are live-only)
  category           String
  /// public | member
  audience           String            @default("member")
  /// draft | published | archived
  status             String            @default("draft")
  title              String
  body               String
  summary            String            @default("")
  url                String?
  tags               String[]          @default([])
  publicationCodes   String[]          @default([]) @map("publication_codes")
  /// manual | pubsetup | brain | website | gap | platform
  source             String            @default("manual")
  /// Stable id of what this was made from (pubsetup:pub:<id>, brain:<noteId>, site:<url>). Unique per brand.
  sourceRef          String?           @map("source_ref")
  /// Hash of the source content at the last sync; a change means the source was edited.
  sourceHash         String?           @map("source_hash")
  /// Edited here: imports and syncs skip it.
  locked             Boolean           @default(false)
  /// Website directory fields (publishedAt, author, product, accessLevel, siteStatus, notes).
  meta               Json              @default("{}")
  /// Gate rules hit at the last save (ids), and the overridable ones a publisher confirmed.
  gateHits           String[]          @default([]) @map("gate_hits")
  gateOverrides      String[]          @default([]) @map("gate_overrides")
  /// Pricing only: a person with support.publish confirmed this is the current retail list price.
  priceConfirmedAt   DateTime?         @map("price_confirmed_at")
  priceConfirmedById String?           @map("price_confirmed_by_id") @db.Uuid
  createdById        String?           @map("created_by_id") @db.Uuid
  updatedById        String?           @map("updated_by_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  revisions          SupportRevision[]
  chunks             SupportChunk[]

  @@unique([brandId, sourceRef])
  @@index([organizationId, brandId, status, category])
  @@map("support_records")
}

/// The record as it was before an edit or delete.
model SupportRevision {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  recordId       String        @map("record_id") @db.Uuid
  snapshot       Json
  note           String        @default("")
  editedById     String?       @map("edited_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  record         SupportRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, createdAt])
  @@map("support_revisions")
}

/// Search passages. category/audience/status are copied from the record so the agent
/// scope filter is plain SQL with no join. search_vector is generated by Postgres.
model SupportChunk {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  brandId        String                   @map("brand_id") @db.Uuid
  recordId       String                   @map("record_id") @db.Uuid
  category       String
  audience       String
  status         String
  ord            Int                      @default(0)
  title          String
  content        String
  searchVector   Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(content, ''::text)), 'B'::\"char\"))")) @map("search_vector")
  record         SupportRecord            @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([organizationId, brandId, status, category, audience])
  @@index([recordId])
  @@index([searchVector], type: Gin)
  @@map("support_chunks")
}

/// One support agent (chat widget, member chat, phone). Its API key IS its scope.
model SupportAgentProfile {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @map("organization_id") @db.Uuid
  brandId          String               @map("brand_id") @db.Uuid
  name             String
  personaName      String               @default("Merlin") @map("persona_name")
  /// chat | member-chat | phone | other
  surface          String               @default("chat")
  categories       String[]             @default([])
  audiences        String[]             @default(["public"])
  instructions     String               @default("")
  escalation       String               @default("")
  firstMessage     String               @default("") @map("first_message")
  /// SHA-256 of the key (shown once). Null until a key is made.
  keyHash          String?              @unique @map("key_hash")
  keyPrefix        String?              @map("key_prefix")
  keyCreatedAt     DateTime?            @map("key_created_at")
  active           Boolean              @default(true)
  rateLimit        Int                  @default(120) @map("rate_limit")
  lastUsedAt       DateTime?            @map("last_used_at")
  /// Post-call webhook signing secret, encrypted with AUTH_SECRET.
  webhookSecretEnc String?              @map("webhook_secret_enc")
  /// none | elevenlabs
  platform         String               @default("none")
  remoteAgentId    String?              @map("remote_agent_id")
  /// ElevenLabs workspace secret that holds this agent's key, used by the pushed tools.
  remoteSecretId   String?              @map("remote_secret_id")
  autoSync         Boolean              @default(false) @map("auto_sync")
  lastPushedAt     DateTime?            @map("last_pushed_at")
  lastPushedPrompt String?              @map("last_pushed_prompt")
  lastSyncResult   Json?                @map("last_sync_result")
  /// queued | running | done | failed
  syncStatus       String               @default("idle") @map("sync_status")
  createdById      String?              @map("created_by_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")
  platformDocs     SupportPlatformDoc[]

  @@index([organizationId, brandId, deletedAt])
  @@map("support_agent_profiles")
}

/// A brand's ElevenLabs connection: the user's own API key, encrypted with AUTH_SECRET.
model SupportConnection {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  brandId        String   @map("brand_id") @db.Uuid
  platform       String   @default("elevenlabs")
  apiKeyEnc      String   @map("api_key_enc")
  keyHint        String   @map("key_hint")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([brandId, platform])
  @@map("support_connections")
}

/// Sync state of one pushed document or tool on the platform.
model SupportPlatformDoc {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  profileId      String              @map("profile_id") @db.Uuid
  /// doc | tool
  kind           String              @default("doc")
  docKey         String              @map("doc_key")
  name           String              @default("")
  remoteId       String?             @map("remote_id")
  contentHash    String              @default("") @map("content_hash")
  /// Hash of the platform's copy right after our push: the baseline for edit detection.
  remoteHash     String?             @map("remote_hash")
  /// synced | pending | error | remote_changed
  status         String              @default("pending")
  error          String?
  lastPushedAt   DateTime?           @map("last_pushed_at")
  lastPulledAt   DateTime?           @map("last_pulled_at")
  profile        SupportAgentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, kind, docKey])
  @@map("support_platform_docs")
}

/// Review queue: Brain notes proposed for copying, and edits or new documents found on the platform.
model SupportProposal {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  /// brain-note | platform-edit | platform-new
  kind           String
  title          String
  text           String
  sourceRef      String?   @map("source_ref")
  profileId      String?   @map("profile_id") @db.Uuid
  targetId       String?   @map("target_id") @db.Uuid
  gateHits       String[]  @default([]) @map("gate_hits")
  /// pending | approved | rejected
  status         String    @default("pending")
  recordId       String?   @map("record_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  decidedById    String?   @map("decided_by_id") @db.Uuid
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, brandId, status])
  @@map("support_proposals")
}

/// A question an agent could not answer.
model SupportGap {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  profileId      String?   @map("profile_id") @db.Uuid
  question       String
  normalized     String
  reason         String    @default("")
  /// webhook | manual
  source         String    @default("manual")
  conversationId String?   @map("conversation_id")
  count          Int       @default(1)
  /// open | resolved | dismissed
  status         String    @default("open")
  recordId       String?   @map("record_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  resolvedAt     DateTime? @map("resolved_at")

  @@unique([brandId, normalized])
  @@index([organizationId, brandId, status])
  @@map("support_gaps")
}

/// Every agent API call: the audit trail and the rolling rate-limit window. No customer text beyond the query.
model SupportApiCall {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  tool           String
  query          String   @default("")
  hits           Int      @default(0)
  status         Int
  durationMs     Int      @default(0) @map("duration_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([profileId, createdAt])
  @@map("support_api_calls")
}

/// Per-brand settings: website ingest key and sheet, default persona.
model SupportSettings {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  brandId            String    @map("brand_id") @db.Uuid
  personaName        String    @default("Merlin") @map("persona_name")
  escalation         String    @default("")
  ingestKeyHash      String?   @unique @map("ingest_key_hash")
  ingestKeyPrefix    String?   @map("ingest_key_prefix")
  siteSheetUrl       String?   @map("site_sheet_url")
  siteSheetSync      Boolean   @default(false) @map("site_sheet_sync")
  lastSheetSyncAt    DateTime? @map("last_sheet_sync_at")
  lastSheetResult    Json?     @map("last_sheet_result")
  pubsetupSync       Boolean   @default(true) @map("pubsetup_sync")
  lastPubsetupAt     DateTime? @map("last_pubsetup_at")
  lastPubsetupResult Json?     @map("last_pubsetup_result")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([brandId])
  @@map("support_settings")
}
