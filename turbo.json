{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "@pubcommand/db#generate"]
    },
    "test": {
      "dependsOn": ["@pubcommand/db#generate"]
    },
    "build": {
      "dependsOn": ["^typecheck", "@pubcommand/db#generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
